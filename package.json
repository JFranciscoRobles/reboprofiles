{
  "name": "reboprofiles",
  "version": "0.1.0",
  "description": "Profile pages for the browser, with an engine of their own: one address with who someone is, how to reach them, their links, networks and what they offer, written in a form beside the page as it will look.",
  "license": "MIT",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "npm run dev -w @reboprofiles/playground",
    "build": "npm run build -w @reboprofiles/playground",
    "site": "npm run dev -w @reboprofiles/site",
    "build:site": "npm run build -w @reboprofiles/site",
    "test": "vitest run",
    "coverage": "vitest run --coverage --coverage.include='packages/*/src/**'",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "format": "biome check --write .",
    "build:packages": "npm run build -w @reboprofiles/core -w @reboprofiles/react",
    "release": "npm run build:packages && node tools/release.mjs"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitest/coverage-v8": "^5.0.5",
    "happy-dom": "^21.0.4",
    "jsqr": "^1.4.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  }
}
